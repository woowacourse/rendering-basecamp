{
  "name": "ssr",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build:css": "postcss public/styles/index.css --use postcss-import --output public/styles/bundle.css --no-map",
    "build": "npm run build:css && tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "npm run build:css && nodemon --exec ts-node src/server.ts",
    "clean": "rm -rf dist public/styles/bundle.css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Node.js SSR with TypeScript",
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
