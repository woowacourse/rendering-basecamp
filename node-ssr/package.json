{
  "name": "ssr",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build:css": "esbuild public/styles/index.css --bundle --minify --outfile=public/assets/styles.min.css",
    "build": "npm run build:css && tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "nodemon --watch src --watch public/styles --ext ts,json,css --exec \"npm run build:css && ts-node src/server.ts\"",
    "clean": "rm -rf dist public/assets/styles.min.css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Node.js SSR with TypeScript",
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
